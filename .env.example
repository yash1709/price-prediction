# Copy to .env and adjust. No credentials are required for the default yfinance provider.
DATABASE_URL=sqlite:///data/nse.db
ARTIFACTS_DIR=artifacts
DATA_DIR=data
# yfinance | csv
DATA_PROVIDER=yfinance
CSV_DATA_DIR=data/csv
DEFAULT_HISTORY_YEARS=8
CACHE_TTL_HOURS=6
# re-check interval while the newest bar has no final price yet
PENDING_RETRY_MINUTES=15
MIN_TRAIN_ROWS=250
WALK_FORWARD_FOLDS=8
WALK_FORWARD_TEST_SIZE=21
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Official NSE equity list (NSE may block automated downloads; a local file path also works)
UNIVERSE_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv
